{
  "expo": {
    "name": "GymLife RPG",
    "slug": "gym-life-rpg",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "splash": {
      "backgroundColor": "#0b0c0d",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#0b0c0d",
    "primaryColor": "#e6a94f",
    "plugins": [
      "expo-router",
      "@sentry/react-native/expo",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O GymLife RPG usa sua localização aproximada só para mostrar o clima do reino no Painel.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "scheme": "gymliferpg",
    "jsEngine": "hermes"
  }
}
